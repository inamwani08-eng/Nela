# Copy to .env (never commit it). In GitHub, add these as repository secrets.

# Server key for the data pipeline. Enable: Geocoding API, Places API (New).
# Restrict it by API, not by referrer.
GOOGLE_MAPS_API_KEY=

# Browser key for the website. Enable: Maps JavaScript API, Places API (New),
# Distance Matrix API. Restrict it to your site's domains (HTTP referrers).
VITE_GOOGLE_MAPS_API_KEY=
# Optional: a Map ID from Google Cloud for custom map styling.
VITE_GOOGLE_MAP_ID=

# Crawl politeness (optional)
CRAWL_DELAY_MS=3000
